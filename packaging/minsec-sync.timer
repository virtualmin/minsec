[Unit]
Description=Run minsec multiplayer sync hourly

[Timer]
OnBootSec=2min
OnUnitActiveSec=1h
# Spread agent traffic across the hour rather than stacking on the boot
# offset; the free feed is not real-time and nothing here is latency
# sensitive.
RandomizedDelaySec=5min

[Install]
WantedBy=timers.target
